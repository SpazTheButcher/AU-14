<cmu:GunshipControlsWindow xmlns="https://spacestation14.io"
    xmlns:cmu="clr-namespace:Content.Client._CMU14.Dropship.GunshipControls"
    SetSize="360 190"
    MinSize="320 170">
    <PanelContainer>
        <BoxContainer Orientation="Vertical"
                      SeparationOverride="10"
                      Margin="12">
            <Label Text="Select a gunship control interface."
                   HorizontalAlignment="Center"
                   StyleClasses="LabelSubText" />
            <Button Name="NavigationButton"
                    Text="Navigation Controls"
                    HorizontalExpand="True"
                    MinHeight="36" />
            <Button Name="WeaponsButton"
                    Text="Weapon Controls"
                    HorizontalExpand="True"
                    MinHeight="36" />
        </BoxContainer>
    </PanelContainer>
</cmu:GunshipControlsWindow>
